<?xml version="1.0"?>
<sdf version="1.6">
  <world name="navapex">
    <physics name="default" type="ode">
      <max_step_size>0.005</max_step_size>
      <real_time_update_rate>200</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <gui fullscreen="false">
      <camera name="user_camera">
        <pose>7 -9 8 0 0.65 2.15</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular><direction>-0.5 -0.5 -1</direction>
    </light>
    <model name="ground_plane">
      <static>true</static><link name="ground">
        <collision name="ground"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="ground"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="west_wall"><static>true</static><pose>-4 0 0.5 0 0 0</pose><link name="wall">
      <collision name="wall"><geometry><box><size>0.1 8 1</size></box></geometry></collision>
      <visual name="wall"><geometry><box><size>0.1 8 1</size></box></geometry></visual></link></model>
    <model name="east_wall"><static>true</static><pose>6 0 0.5 0 0 0</pose><link name="wall">
      <collision name="wall"><geometry><box><size>0.1 8 1</size></box></geometry></collision>
      <visual name="wall"><geometry><box><size>0.1 8 1</size></box></geometry></visual></link></model>
    <model name="south_wall"><static>true</static><pose>1 -4 0.5 0 0 0</pose><link name="wall">
      <collision name="wall"><geometry><box><size>10 0.1 1</size></box></geometry></collision>
      <visual name="wall"><geometry><box><size>10 0.1 1</size></box></geometry></visual></link></model>
    <model name="north_wall"><static>true</static><pose>1 4 0.5 0 0 0</pose><link name="wall">
      <collision name="wall"><geometry><box><size>10 0.1 1</size></box></geometry></collision>
      <visual name="wall"><geometry><box><size>10 0.1 1</size></box></geometry></visual></link></model>
    <model name="center_obstacle"><static>true</static><pose>1.6 0 0.5 0 0 0</pose><link name="obstacle">
      <collision name="obstacle"><geometry><box><size>0.6 1.8 1</size></box></geometry></collision>
      <visual name="obstacle"><geometry><box><size>0.6 1.8 1</size></box></geometry>
        <material><ambient>0.8 0.25 0.15 1</ambient><diffuse>0.8 0.25 0.15 1</diffuse></material></visual></link></model>
    <model name="side_obstacle"><static>true</static><pose>3 -2 0.5 0 0 0</pose><link name="obstacle">
      <collision name="obstacle"><geometry><box><size>1.5 0.6 1</size></box></geometry></collision>
      <visual name="obstacle"><geometry><box><size>1.5 0.6 1</size></box></geometry></visual></link></model>
  </world>
</sdf>
